{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|mcp__xcode-tools__XcodeWrite|mcp__xcode-tools__XcodeUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/swiftlint.sh",
            "timeout": 30,
            "statusMessage": "Running SwiftLint..."
          }
        ]
      }
    ]
  }
}
